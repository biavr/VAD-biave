#!/usr/bin/env python3
"""Executable shim so Rerun can find this plugin as `rerun-importer-nuscenes`.

Rerun's external-importer mechanism only looks for an executable named
`rerun-importer-<name>` on `$PATH` -- it doesn't know about Python packages.
(The older `rerun-loader-<name>` prefix still works for backward
compatibility but is deprecated and prints a warning.) The real logic lives
in `nuscenes_rerun.loader_entry` so it stays shared with the `nuscenes_rerun`
CLI; this file just makes that package importable and calls it. See
install.sh for how this gets linked onto `$PATH`.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from nuscenes_rerun.loader_entry import main  # noqa: E402

if __name__ == "__main__":
    main()
